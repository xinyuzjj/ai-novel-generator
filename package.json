{
  "name": "ai-novel-generator",
  "version": "1.0.0",
  "description": "Login-free AI Novel Generator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "mobile:init": "cap init",
    "mobile:sync": "cap sync",
    "mobile:open": "cap open android"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/core": "^5.0.0",
    "@capacitor/android": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.ainovel.generator",
    "productName": "AI Novel Generator",
    "directories": {
      "output": "build"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!build/*",
      "!.git/*"
    ]
  }
}