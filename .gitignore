.vscode/
.idea/
*.swp
*.swo

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 临时文件
tmp/
temp/
*.tmp

# 压缩文件
*.zip
*.rar
*.7z

