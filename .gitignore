# 构建输出文件夹（绝对不能上传）
build/
dist/

# 数据文件夹（包含测试数据和用户数据，不能上传）
data/
!data/.gitkeep

# 分割章节临时文件夹
split_chapters/
test-chapters/

# 日志文件
*.log

# 操作系统文件
.DS_Store
Thumbs.db

